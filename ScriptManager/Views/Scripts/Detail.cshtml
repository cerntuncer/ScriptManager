@model ScriptManager.Models.Script.ScriptListItemViewModel
@using DAL.Enums
@{
    var canDelete = ViewBag.CanDelete as bool? == true;
    var st = Model.StatusEnum;
    var canMarkDraftReady = ViewBag.CanMarkDraftReady as bool? == true;
    var canSendToTester = ViewBag.CanSendToTester as bool? == true;
    var canApproveTesterReview = ViewBag.CanApproveTesterReview as bool? == true;
    var canEditDraftScript = ViewBag.CanEditDraftScript as bool? == true;
}

<div class="page-head">
    <div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">
            @Model.BatchName · @Model.DeveloperName · @Model.StatusDisplay · @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
        </p>
    </div>
    <div class="page-actions d-flex flex-wrap gap-2">
        @if (canDelete)
        {
            <button type="button" class="btn btn-outline-danger modern-btn" onclick="deleteScript(@Model.ScriptId)">Sil</button>
        }
        <a class="btn btn-light modern-btn" href="@Url.Action("Index", "Scripts")">← Script listesi</a>
    </div>
</div>

<div class="panel-card mb-4">
    <div class="panel-header">
        <h3 class="mb-0">Durum akışı</h3>
    </div>
    <div class="p-3">
        <p class="small text-muted mb-3 mb-md-2">
            <strong>Taslak</strong>: geliştirici <strong>Testçiye gönderebilir</strong> veya (kendi scriptinde) doğrudan <strong>Hazır</strong> yapabilir; testçi herhangi bir taslağı Hazır yapabilir.
            <strong>Testçi incelemesinde</strong>: yalnızca testçi <strong>Hazır</strong> onayı verir.
            <strong>Çakışma</strong>: aynı sürümde örtüşen SQL tespit edildiğinde script bu duruma alınır; <a href="@Url.Action("Index", "Conflicts")">Çakışmalar</a> sayfasında çözülene kadar Hazır ve testçi adımları kapalıdır.
        </p>
        @if (st == ScriptStatus.Conflict)
        {
            <p class="small text-warning mb-0">
                Bu script <strong>çakışma</strong> durumunda. <a href="@Url.Action("Index", "Conflicts")">Çakışmalar</a> sayfasından ilgili kaydı görüntüleyin; geliştirici çözümledikten sonra durumunuz çakışma öncesi (ör. Taslak) haline döner.
            </p>
        }
        else if (st == ScriptStatus.Ready)
        {
            <p class="mb-0 small text-success">Bu script <strong>hazır</strong> — paketleme ve sonraki adımlar için uygun.</p>
        }
        else if (st == ScriptStatus.PendingTesterReview)
        {
            @if (canApproveTesterReview)
            {
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-primary" onclick="changeScriptStatus(@Model.ScriptId, @((int)ScriptStatus.Ready))">Onayla — Hazır yap</button>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">Bu script testçi incelemesinde. Onayı testçi verir.</p>
            }
        }
        else if (canSendToTester || canMarkDraftReady)
        {
            <div class="d-flex flex-wrap gap-2">
                @if (canSendToTester)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="changeScriptStatus(@Model.ScriptId, @((int)ScriptStatus.PendingTesterReview))">Testçiye gönder</button>
                }
                @if (canMarkDraftReady)
                {
                    <button type="button" class="btn btn-sm btn-primary" onclick="changeScriptStatus(@Model.ScriptId, @((int)ScriptStatus.Ready))">Hazır olarak işaretle</button>
                }
            </div>
        }
        else
        {
            <p class="text-muted small mb-0">Bu durum için sizin rolünüzde işlem yok veya kayıt zaten güncel.</p>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ReferencedTablesDisplay))
{
    <div class="panel-card mb-4">
        <div class="panel-header">
            <h3 class="mb-0">Etkilenen tablolar</h3>
        </div>
        <div class="p-3">
            <p class="small text-muted mb-2">Koddan otomatik tespit edildi.</p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var tbl in Model.ReferencedTablesDisplay.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                {
                    <span class="badge text-bg-light border small font-monospace">@tbl</span>
                }
            </div>
        </div>
    </div>
}

@if (canEditDraftScript)
{
    <div class="panel-card mb-4" id="editScriptPanel" style="display:none">
        <div class="panel-header d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Scripti düzenle</h3>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleEditPanel()">Kapat</button>
        </div>
        <div class="p-3" id="editScriptForm">
            <div class="mb-3">
                <label class="form-label fw-semibold small">Script adı</label>
                <input id="editName" type="text" class="form-control" value="@Model.Name" maxlength="200" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small d-flex align-items-center gap-2">
                    SQL
                    <span id="editSqlBadge" class="sw-sql-badge sw-sql-badge--idle">— kontrol bekleniyor</span>
                </label>
                <textarea id="editSql" class="form-control font-monospace" rows="10" style="font-size:13px;">@Model.SqlScript</textarea>
                <div id="editSqlValidateBox" class="alert d-none small mt-2 py-2" role="status"></div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small">Rollback SQL <span class="text-muted">(opsiyonel)</span></label>
                <textarea id="editRollback" class="form-control font-monospace" rows="5" style="font-size:13px;">@(Model.RollbackScript ?? "")</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold small d-flex align-items-center gap-2">
                    Hedef ortam
                    <span class="text-muted fw-normal" style="font-size:11px">(şema kontrolü — seçilirse kaydetme bloklanır)</span>
                </label>
                <select id="editSchemaEnvId" class="form-select form-select-sm" style="max-width:360px">
                    <option value="">— Şema kontrolü yapma —</option>
                </select>
                <div id="editSchemaBox" class="alert d-none small mt-2" role="status"></div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-primary" id="editSaveBtn" onclick="saveScriptEdit()">Kaydet</button>
                <button type="button" class="btn btn-light" onclick="toggleEditPanel()">İptal</button>
            </div>
        </div>
    </div>
}

<div class="content-grid single-column" id="scriptViewPanels">
    <section class="panel-card">
        <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 class="mb-0">SQL</h3>
            <div class="d-flex gap-2">
                @if (canEditDraftScript)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleEditPanel()">Düzenle</button>
                }
                <button type="button" class="btn btn-sm btn-outline-primary"
                        onclick="downloadTextFile('@(Model.ScriptId)-script.sql', document.getElementById('sqlBlock').innerText)">
                    .sql indir
                </button>
            </div>
        </div>
        <pre id="sqlBlock" class="code-box">@Model.SqlScript</pre>
    </section>

    <section class="panel-card code-panel">
        <div class="panel-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3 class="mb-0">Rollback SQL</h3>
            @if (!string.IsNullOrWhiteSpace(Model.RollbackScript))
            {
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        onclick="downloadTextFile('@(Model.ScriptId)-rollback.sql', document.getElementById('rbBlock').innerText)">
                    Rollback indir
                </button>
            }
        </div>
        @if (string.IsNullOrWhiteSpace(Model.RollbackScript))
        {
            <p class="text-muted mb-0 px-3 py-2">Rollback tanımlı değil.</p>
        }
        else
        {
            <pre id="rbBlock" class="code-box">@Model.RollbackScript</pre>
        }
    </section>
</div>

@section Scripts {
    <script>
        const __scriptUpdateUrl = "@Url.Action("Update", "Scripts")";
        const __scriptValidateSqlUrl = "@Url.Action("ValidateSql", "Scripts")";
        const __scriptChangeStatusUrl = "@Url.Action("ChangeStatus", "Scripts")";
        const __scriptDeleteUrl = "@Url.Action("Delete", "Scripts")";

        async function changeScriptStatus(scriptId, newStatus) {
            const res = await fetch(__scriptChangeStatusUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json", Accept: "application/json" },
                body: JSON.stringify({ scriptId, newStatus })
            });
            let data = null;
            try { data = await res.json(); } catch (_) {}
            if (!res.ok || data?.success === false) {
                showToast(data?.message || "Durum güncellenemedi.", "error");
                return;
            }
            showToast(data?.message || "Tamam.", "success");
            window.location.reload();
        }

        // ── Canlı SQL syntax validation (edit formu) ───────────────────────
        let __editValidationInited = false;

        function renderEditSqlBox(data) {
            const box   = document.getElementById("editSqlValidateBox");
            const badge = document.getElementById("editSqlBadge");
            const btn   = document.getElementById("editSaveBtn");

            function setBadge(state, text) {
                if (!badge) return;
                badge.className = "sw-sql-badge sw-sql-badge--" + state;
                badge.textContent = text;
            }

            if (!box) return;

            if (!data || data.success === false) {
                box.className = "alert alert-danger small mt-2 py-2";
                box.classList.remove("d-none");
                box.innerHTML = escapeHtml(data?.message || "Doğrulama hatası.");
                setBadge("error", "✗ Hatalı");
                if (btn) btn.disabled = true;
                return;
            }

            if (data.isValid) {
                box.className = "d-none";
                setBadge("ok", "✓ SQL geçerli");
                if (btn) btn.disabled = false;
                return;
            }

            // Hatalar var
            const items = (data.issues || []).map(i => {
                const prefix = i.source && i.source !== "SQL" ? `(${i.source}) ` : "";
                return escapeHtml(prefix + (i.message || ""));
            });
            box.className = "alert alert-danger small mt-2 py-2";
            box.classList.remove("d-none");
            box.innerHTML = items.map(t => `<div>${t}</div>`).join("") || "T-SQL sözdizimi hatalı.";
            setBadge("error", "✗ Hatalı");
            if (btn) btn.disabled = true;
        }

        function initEditFormValidation() {
            if (__editValidationInited) return;
            __editValidationInited = true;

            const sqlEl = document.getElementById("editSql");
            const rbEl  = document.getElementById("editRollback");
            const badge = document.getElementById("editSqlBadge");
            const box   = document.getElementById("editSqlValidateBox");
            const btn   = document.getElementById("editSaveBtn");

            if (!sqlEl) return;

            const doValidate = debounce(async () => {
                const sql = sqlEl.value ?? "";
                const rb  = rbEl?.value ?? "";

                if (!sql.trim()) {
                    if (badge) { badge.className = "sw-sql-badge sw-sql-badge--idle"; badge.textContent = "— kontrol bekleniyor"; }
                    if (box)   { box.className = "d-none"; }
                    if (btn)   { btn.disabled = false; }
                    return;
                }

                if (badge) { badge.className = "sw-sql-badge sw-sql-badge--checking"; badge.textContent = "⟳ kontrol ediliyor…"; }

                try {
                    const res  = await fetch(__scriptValidateSqlUrl, {
                        method: "POST",
                        headers: { "Content-Type": "application/json", Accept: "application/json" },
                        body: JSON.stringify({ sqlScript: sql, rollbackScript: rb })
                    });
                    const data = await res.json().catch(() => null);
                    if (!res.ok || !data) { renderEditSqlBox({ success: false, message: `HTTP ${res.status}` }); return; }
                    renderEditSqlBox(data);
                } catch {
                    if (badge) { badge.className = "sw-sql-badge sw-sql-badge--idle"; badge.textContent = "— doğrulama yapılamadı"; }
                }
            }, 700);

            sqlEl.addEventListener("input", doValidate);
            rbEl?.addEventListener("input", doValidate);
        }
        // ────────────────────────────────────────────────────────────────────

        function toggleEditPanel() {
            const panel = document.getElementById("editScriptPanel");
            if (!panel) return;
            const opening = panel.style.display === "none";
            panel.style.display = opening ? "" : "none";
            if (opening) {
                void loadSchemaEnvOptions("editSchemaEnvId");
                initEditFormValidation();
            }
        }

        async function saveScriptEdit() {
            const name     = document.getElementById("editName")?.value?.trim();
            const sql      = document.getElementById("editSql")?.value;
            const rollback = document.getElementById("editRollback")?.value;
            if (!name || !sql?.trim()) { showToast("Ad ve SQL zorunludur.", "error"); return; }

            const saveBtn = document.getElementById("editSaveBtn");
            saveBtn.disabled = true;

            try {
                // 1) SQL sözdizimi kontrolü (bloklayan)
                try {
                    const valRes = await fetch(__scriptValidateSqlUrl, {
                        method: "POST",
                        headers: { "Content-Type": "application/json", Accept: "application/json" },
                        body: JSON.stringify({ sqlScript: sql, rollbackScript: rollback || "" })
                    });
                    const valData = await valRes.json().catch(() => null);
                    if (!valRes.ok || !valData?.success) {
                        renderEditSqlBox({ success: false, message: valData?.message || "SQL doğrulanamadı." });
                        showToast("SQL sözdizimi hatalı; önce düzeltin.", "error");
                        return;
                    }
                    renderEditSqlBox(valData);
                    if (!valData.isValid) return;
                } catch {
                    showToast("SQL doğrulama isteği gönderilemedi.", "error");
                    return;
                }

                // 2) Şema kontrolü (bloklayan — env seçildiyse)
                const envId = parseInt(document.getElementById("editSchemaEnvId")?.value || "0");
                if (envId > 0) {
                    const schOk = await validateSchemaAndRender(sql, rollback || null, envId, "editSchemaBox");
                    if (!schOk) return;
                }

                // 3) Kaydet
                const res = await fetch(__scriptUpdateUrl, {
                    method: "POST",
                    headers: { "Content-Type": "application/json", Accept: "application/json" },
                    body: JSON.stringify({ scriptId: @Model.ScriptId, name, sqlScript: sql, rollbackScript: rollback || null })
                });
                let data = null;
                try { data = await res.json(); } catch { /* ignore */ }
                if (!res.ok || data?.success === false) {
                    showToast(data?.message || "Güncellenemedi.", "error");
                    return;
                }

                showToast("Script kaydedildi.", "success");
                if (typeof refreshConflictCountBadge === "function") void refreshConflictCountBadge();

                const h1 = document.querySelector(".page-title");
                if (h1) h1.textContent = name;
                const sqlBlock = document.getElementById("sqlBlock");
                if (sqlBlock) sqlBlock.textContent = sql;
                const rbBlock = document.getElementById("rbBlock");
                if (rbBlock) rbBlock.textContent = rollback || "";
                document.getElementById("editScriptPanel").style.display = "none";

            } finally {
                saveBtn.disabled = false;
            }
        }

        async function deleteScript(id) {
            if (!confirm("Bu script kalıcı olarak silinecek (durum: silindi). Emin misiniz?")) return;
            const res = await fetch(__scriptDeleteUrl + "/" + id, {
                method: "POST",
                headers: { Accept: "application/json" }
            });
            let data = null;
            try { data = await res.json(); } catch (_) {}
            if (!res.ok || !data?.success) {
                showToast(data?.message || "Silinemedi.", "error");
                return;
            }
            showToast(data?.message || "Silindi.", "success");
            window.location.href = "@Url.Action("Index", "Scripts")";
        }
    </script>
}
