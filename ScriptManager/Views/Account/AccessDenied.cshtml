@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Erişim reddedildi";
}

<div class="login-page-wrap">
    <div class="login-card card shadow-sm border-0">
        <div class="card-body p-4 p-md-5 text-center">
            <h1 class="h4 mb-3">Bu sayfayı görüntüleme yetkiniz yok.</h1>
            <p class="text-muted small mb-4">Bu uygulamada hesaplar <strong>geliştirici</strong> veya <strong>testçi</strong> rolündedir; ihtiyacınız olan işlem için uygun hesapla giriş yapın.</p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Panele dön</a>
        </div>
    </div>
</div>
