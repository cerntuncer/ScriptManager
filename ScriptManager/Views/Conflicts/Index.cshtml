@model ScriptManager.Models.Conflict.ConflictsIndexViewModel
@using System.Text.Json
@{
    var canResolve = ViewBag.CanResolveConflicts as bool? == true;
    var canViewPair = ViewBag.CanViewConflictPair as bool? == true;
    const string idPh = "999999999";
    var pairTpl = Url.Action("Pair", "Conflicts", new { id = 999999999L });
    var scriptDetailTpl = Url.Action("Detail", "Scripts", new { id = 999999999L });
}

<div class="conflicts-page">
<div class="page-head">
    <div>
        <h1 class="page-title">Çakışmalar</h1>
        <p class="page-sub text-muted mb-0 small">
            Çakışan scriptler <strong>Çakışma</strong> durumuna alınır; Hazır ve testçi adımları kapalı kalır.
            Aynı iki script arasındaki tüm çakışma nedenleri tek satırda toplanır; <strong>Konu</strong> sütununda listelenir.
            Her satırda yalnızca <strong>Görüntüle</strong> vardır: açılan pencerede iki scriptin SQL’ini inceleyebilir,
            geliştirici olarak düzenleyebilir; işi <strong>Kaydet ve çakışma kaydını kapat</strong> veya scripte dokunmadan
            <strong>Düzeltme yapmadan kapat</strong> ile bitirebilirsiniz. Kayıt kapanınca durumlar çakışma öncesi haline döner.
        </p>
    </div>
</div>

<div class="panel-card">
    <div class="panel-header">
        <h3 class="mb-0">Açık çakışmalar (@Model.Rows.Count)</h3>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <p class="text-muted mb-0 p-3">Açık çakışma yok.</p>
    }
    else
    {
        <div class="table-wrap custom-scroll">
            <table class="modern-table">
                <thead>
                <tr>
                    <th>Konu</th>
                    <th>Script 1</th>
                    <th>Script 2</th>
                    <th>Tespit</th>
                    <th></th>
                </tr>
                </thead>
                <tbody id="conflictTableBody">
                @foreach (var r in Model.Rows)
                {
                    <tr data-conflict-id="@r.ConflictId" data-filter-hidden="0">
                        <td class="conflict-topic-cell">
                            <span class="conflict-topic-pill" title="@r.ConflictLabel">@r.ConflictLabel</span>
                        </td>
                        <td>
                            <a href="@Url.Action("Detail", "Scripts", new { id = r.ScriptId })">@r.ScriptName</a>
                            <div class="small text-muted">@r.ScriptDeveloper</div>
                        </td>
                        <td>
                            <a href="@Url.Action("Detail", "Scripts", new { id = r.OtherScriptId })">@r.OtherScriptName</a>
                            <div class="small text-muted">@r.OtherDeveloper</div>
                        </td>
                        <td class="small">@r.DetectedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-nowrap">
                            @if (canViewPair)
                            {
                                <button type="button" class="btn btn-sm btn-primary" onclick="openConflictReviewModal(@r.ConflictId)">Görüntüle</button>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@{
    var resolvedCount = Model.ResolvedRows.Count;
}
<div class="panel-card mt-4" id="conflictResolvedPanel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Son çözümlenenler (<span id="conflictResolvedCount">@resolvedCount</span>)</h3>
    </div>
    <p id="conflictResolvedEmptyHint" class="text-muted mb-0 p-3@(resolvedCount > 0 ? " d-none" : "")">Henüz çözümlenen kayıt yok.</p>
    <div id="conflictResolvedTableWrap" class="table-wrap custom-scroll@(resolvedCount == 0 ? " d-none" : "")">
        <table class="modern-table">
            <thead>
            <tr>
                <th>Sonuç</th>
                <th>Script 1</th>
                <th>Script 2</th>
                <th>Çözen</th>
                <th>Çözüm tarihi</th>
            </tr>
            </thead>
            <tbody id="conflictResolvedTableBody">
            @foreach (var r in Model.ResolvedRows)
            {
                <tr>
                    <td><span class="small">@r.ResolvedKindDisplay</span></td>
                    <td>
                        <a href="@Url.Action("Detail", "Scripts", new { id = r.ScriptId })" class="small">@r.ScriptName</a>
                        <div class="small text-muted">@r.ScriptDeveloper</div>
                    </td>
                    <td>
                        <a href="@Url.Action("Detail", "Scripts", new { id = r.OtherScriptId })" class="small">@r.OtherScriptName</a>
                        <div class="small text-muted">@r.OtherDeveloper</div>
                    </td>
                    <td class="small">@(r.ResolvedByName ?? "—")</td>
                    <td class="small text-muted">@r.ResolvedAtDisplay</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
</div>

@section Scripts {
    <script>
        window.__conflictsUrls = @Html.Raw(JsonSerializer.Serialize(new {
            pairTemplate = pairTpl,
            scriptDetailTemplate = scriptDetailTpl,
            pairPlaceholder = idPh,
            saveReview = Url.Action("SaveReview", "Conflicts"),
            resolve = Url.Action("Resolve", "Conflicts")
        }));
        window.__conflictsCanResolve = @(canResolve ? "true" : "false");

        setupPagination("conflictTableBody", 10);
    </script>
}
